    switch (unionType) {
        case 1: { const auto *item = value->info_as_FuncTyInfo(); CJOFReadSurfaceAdd(out, 177, item != nullptr); CJOFWalkOfficial_FuncTyInfo(item, out); break; }
        case 2: { const auto *item = value->info_as_CompositeTyInfo(); CJOFReadSurfaceAdd(out, 177, item != nullptr); CJOFWalkOfficial_CompositeTyInfo(item, out); break; }
        case 3: { const auto *item = value->info_as_GenericTyInfo(); CJOFReadSurfaceAdd(out, 177, item != nullptr); CJOFWalkOfficial_GenericTyInfo(item, out); break; }
        case 4: { const auto *item = value->info_as_ArrayTyInfo(); CJOFReadSurfaceAdd(out, 177, item != nullptr); CJOFWalkOfficial_ArrayTyInfo(item, out); break; }
        default: break;
