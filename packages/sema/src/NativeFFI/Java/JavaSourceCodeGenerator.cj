package cjcj::sema.NativeFFI.Java

import std.collection.*
import cjcj::ast.*
import cjcj::mangle.BaseMangler
import cjcj::option.MaybeString
import cjcj::sema.NativeFFI.{GetJavaMemberName, GetJavaPackage, GetJavaTopLevelClassName, GetJavaUnqualifiedTypeName,
    GetMangledJniInitCjObjectFuncName, GetMangledMethodName, IsGeneratedJavaImplConstructor, IsJArray}
import cjcj::utils.{CJC_ABORT, CJC_ASSERT, CJC_ASSERT_WITH_MSG, CJC_NULLPTR_CHECK, SplitString, Stoi}

// C++ src/Sema/NativeFFI/Java/JavaCodeGenerator/JavaSourceCodeGenerator.cpp:23-84.
private let JAVA_PUBLIC: String = "public"
private let JAVA_PROTECTED: String = "protected"
private let JAVA_PRIVATE: String = "private"
private let JAVA_SEMICOLON: String = ";"
private let JAVA_COMMA: String = ","
private let JAVA_WHITESPACE: String = " "
private let JAVA_SPECIAL_PARAM_NAME: String = "__init__"
private let REGISTRY_ID_FIELD_NAME: String = "$rid"
private let TAB: String = "    "
private let TAB2: String = TAB + TAB
private let GENERATED_FILE_PREAMBULE: String =
    "/*\n" +
    " * NOTE: This file is auto-generated by cjc.\n" +
    " * Do NOT modify it manually.\n" +
    " */\n"

private func IsFuncDeclAndNotConstructor(member: Decl): Bool {
    return member.astKind == ASTKind.FUNC_DECL && !member.TestAttr(Attribute.CONSTRUCTOR)
}

private func GetModifier(member: Decl): String {
    if (member.TestAttr(Attribute.PUBLIC)) {
        return "public "
    }
    return ""
}

private func GetExportedMemberModifier(member: Decl): String {
    if (member.TestAttr(Attribute.PUBLIC)) {
        return "public "
    } else if (member.TestAttr(Attribute.PROTECTED)) {
        return "protected "
    }
    CJC_ABORT()
    return ""
}

private func FuncParamToString(param: FuncParam): String {
    CJC_ASSERT(param.typeNode.isSome() && param.GetTy().isSome())
    return param.identifier.Val()
}

// C++ src/Sema/NativeFFI/Java/JavaCodeGenerator/JavaSourceCodeGenerator.cpp:87-737.
public class JavaSourceCodeGenerator <: AbstractSourceCodeGenerator {
    private static let DEFAULT_OUTPUT_DIR: String = "java-gen"
    private static let IGNORE_IMPORT: String = "java.lang"

    private let decl: Decl
    private let imports: TreeSet<String>
    private let cjLibName: String
    private let mangler: BaseMangler
    private let ctx: AfterTypeCheckContext
    private let extendDecls: ArrayList<ExtendDecl>

    public init(decl: Decl, mangler: BaseMangler, ctx: AfterTypeCheckContext, outputFolderPath: MaybeString,
        outputFileName: String, cjLibName: String, extendDecls: ArrayList<ExtendDecl>) {
        super(if (outputFolderPath.hasValue) { outputFolderPath.value } else { DEFAULT_OUTPUT_DIR }, outputFileName)
        this.decl = decl
        this.imports = TreeSet<String>()
        this.cjLibName = cjLibName
        this.mangler = mangler
        this.ctx = ctx
        this.extendDecls = extendDecls
    }

    protected override func ConstructResult(): Unit {
        if (decl.TestAnyAttr(Attribute.IS_BROKEN, Attribute.HAS_BROKEN)) {
            return
        }
        AddClassDeclaration()
        AddLoadLibrary()
        AddRegistryIdIdField()
        AddProperties()
        AddConstructors()
        AddMethods()
        AddNativeDeleteCJObject()
        AddFinalize()
        AddEndClassParenthesis()
        AddHeader()
    }

    private func IsMemberExportable(member: Decl): Bool {
        if (let Some(outer) <- member.outerDecl) {
            CJC_ASSERT(IsImpl(outer))
        } else {
            CJC_ASSERT(false)
        }
        return member.TestAnyAttr(Attribute.PUBLIC, Attribute.PROTECTED)
    }

    private func AddHeader(): Unit {
        var curPackageName = GetJavaPackage(decl)
        AddHeaderWithPackageName(curPackageName)
    }

    private func AddHeaderWithPackageName(curPackageName: String): Unit {
        var header = GENERATED_FILE_PREAMBULE
        if (!curPackageName.isEmpty()) {
            header += "package"
            header += JAVA_WHITESPACE
            header += curPackageName
            header += JAVA_SEMICOLON
            header += "\n\n"
        }
        let importItems = ArrayList<String>()
        for (item in imports) {
            importItems.add(item)
        }
        header += Join<String>(importItems, "\n", { name: String => "import " + name + ";" }) + "\n"
        header += "import static cangjie.lang.LibraryLoader.loadLibrary;\n"
        header += "import " + JavaClassSignature.GetConstructorMarkerClass().GetFQName() + ";\n"
        header += "\n"
        res = header + res
    }

    private func MapCJTypeToJavaType(ty: Ty, javaImports: TreeSet<String>, curPackageName: String,
        isNativeMethod!: Bool = false): String {
        if (ty.IsCoreOptionType()) {
            return MapCJTypeToJavaType(ty.typeArgs[0], javaImports, curPackageName, isNativeMethod: isNativeMethod)
        }
        if (ty.kind == TypeKind.TYPE_INTERFACE || ty.kind == TypeKind.TYPE_CLASS) {
            if (let Some(declTy) <- Ty.GetDeclOfTy(Some(ty))) {
                if (IsJArray(declTy)) {
                    return MapCJTypeToJavaType(ty.typeArgs[0], javaImports, curPackageName) + "[]"
                }
            }
            let javaType = AddImport(ty, javaImports, curPackageName)
            CJC_ASSERT(!javaType.isEmpty())
            return javaType
        }
        let javaType = match (ty.kind) {
            case TypeKind.TYPE_FLOAT64 => "double"
            case TypeKind.TYPE_FLOAT32 => "float"
            case TypeKind.TYPE_INT64 => "long"
            case TypeKind.TYPE_INT32 => "int"
            case TypeKind.TYPE_INT16 => "short"
            case TypeKind.TYPE_UINT16 => "char"
            case TypeKind.TYPE_INT8 => "byte"
            case TypeKind.TYPE_BOOLEAN => "boolean"
            case TypeKind.TYPE_UNIT => "void"
            case TypeKind.TYPE_STRUCT => ty.name
            case TypeKind.TYPE_ENUM => ty.name
            case _ => if (ty.name == "String") { "String" } else { "" }
        }
        CJC_ASSERT(!javaType.isEmpty())
        return javaType
    }

    private func MapCJTypeToJavaType(tyNode: Type, javaImports: TreeSet<String>, curPackageName: String,
        isNativeMethod!: Bool = false): String {
        CJC_ASSERT(tyNode.GetTy().isSome())
        return MapCJTypeToJavaType(tyNode.GetTy().getOrThrow(), javaImports, curPackageName,
            isNativeMethod: isNativeMethod)
    }

    private func MapCJTypeToJavaType(param: FuncParam, javaImports: TreeSet<String>, curPackageName: String,
        isNativeMethod!: Bool = false): String {
        CJC_ASSERT(param.typeNode.isSome() && param.typeNode.getOrThrow().GetTy().isSome())
        return MapCJTypeToJavaType(param.typeNode.getOrThrow().GetTy().getOrThrow(), javaImports, curPackageName,
            isNativeMethod: isNativeMethod)
    }

    private func AddClassDeclaration(): Unit {
        res += GetModifier(decl)
        let className = decl.identifier.Val()
        res += "class " + className
        if (let Some(classDecl) <- (decl as ClassDecl)) {
            let superClass = classDecl.GetSuperClassDecl()
            CJC_NULLPTR_CHECK(superClass)
            let superDecl = superClass.getOrThrow()
            let inherited = !IsJObject(superDecl) && !IsObject(superDecl)
            let ifaces = classDecl.GetSuperInterfaceTys()
            if (inherited) {
                res += " extends "
                res += MapCJTypeToJavaType(superDecl.GetTy().getOrThrow(), imports, classDecl.fullPackageName)
            }
            if (!ifaces.isEmpty()) {
                res += " implements "
                res += Join<InterfaceTy>(ifaces, ", ", { iface: InterfaceTy =>
                    MapCJTypeToJavaType(iface, imports, classDecl.fullPackageName)
                })
            }
        }
        res += " {\n"
    }

    private static func AddImport(ty: Ty, javaImports: TreeSet<String>, curPackageName: String): String {
        if (let Some(classLikeTy) <- (ty as ClassLikeTy)) {
            if (let Some(clDecl) <- classLikeTy.commonDecl) {
                let packageName = GetJavaPackage(clDecl)
                let topLevelClassName = GetJavaTopLevelClassName(clDecl)
                let fullClassName = GetJavaUnqualifiedTypeName(clDecl, ".")
                if (packageName.isEmpty()) {
                    return fullClassName
                }
                if (packageName != curPackageName && packageName != IGNORE_IMPORT) {
                    javaImports.add(packageName + "." + topLevelClassName)
                }
                return fullClassName
            }
        }
        return ""
    }

    private func AddLoadLibrary(): Unit {
        AddWithIndent(TAB, "static {")
        AddWithIndent(TAB2, "loadLibrary(\"" + cjLibName + "\");")
        AddWithIndent(TAB, "}\n")
    }

    private func AddRegistryIdIdField(): Unit {
        AddWithIndent(TAB, "private long " + REGISTRY_ID_FIELD_NAME + ";\n")
    }

    private func AddProperties(): Unit {
        let propDecls = ArrayList<Decl>()
        for (extendDecl in extendDecls) {
            for (member in extendDecl.GetMemberDecls()) {
                if (member.astKind != ASTKind.PROP_DECL || member.TestAttr(Attribute.COMPILER_ADD)) {
                    continue
                }
                if (member.TestAttr(Attribute.PUBLIC)) {
                    propDecls.add(member)
                }
            }
        }
        for (member in decl.GetMemberDecls()) {
            if (member.astKind != ASTKind.PROP_DECL || member.TestAttr(Attribute.COMPILER_ADD)) {
                continue
            }
            if (IsMemberExportable(member)) {
                propDecls.add(member)
            }
        }
        for (pdecl in propDecls) {
            let propDecl = (pdecl as PropDecl).getOrThrow()
            CJC_ASSERT_WITH_MSG(!propDecl.getters.isEmpty(), "property must have at least one getter")
            let typeName = MapCJTypeToJavaType(propDecl.GetTy().getOrThrow(), imports, decl.fullPackageName,
                isNativeMethod: false)
            var varDecl = GetJavaMemberName(propDecl)
            var varDeclSuffix = varDecl
            CJC_ASSERT_WITH_MSG(!varDeclSuffix.isEmpty(), "identifier cannot be an empty string")
            varDeclSuffix = varDeclSuffix[0..1].toAsciiUpper() + varDeclSuffix[1..]
            let getSignature = "get" + varDeclSuffix
            let isStaticProp = propDecl.TestAttr(Attribute.STATIC)
            let modifier = GetExportedMemberModifier(pdecl)
            let getterStatic = if (isStaticProp) { "static " } else { "" }
            AddWithIndent(TAB, modifier + getterStatic + "final " + typeName + " " + getSignature + "() {")
            let getRegIdStr = if (isStaticProp) { "" } else { "this." + REGISTRY_ID_FIELD_NAME }
            AddWithIndent(TAB2, "return " + getSignature + "Impl(" + getRegIdStr + ");")
            AddWithIndent(TAB, "}\n")
            let getRegIdNativeStr = if (isStaticProp) { "" } else { "long " + REGISTRY_ID_FIELD_NAME }
            AddWithIndent(TAB,
                "private " + getterStatic + "final native " + typeName + " " + getSignature + "Impl(" +
                    getRegIdNativeStr + ");\n")
            if (!propDecl.setters.isEmpty()) {
                let setterStatic = if (isStaticProp) { "static " } else { "" }
                let setSignature = "set" + varDeclSuffix
                AddWithIndent(TAB,
                    modifier + setterStatic + "final void " + setSignature + "(" + typeName + " " + varDecl + ") {")
                let setRegIdStr = if (isStaticProp) { "" } else { "this." + REGISTRY_ID_FIELD_NAME + ", " }
                AddWithIndent(TAB2, setSignature + "Impl(" + setRegIdStr + varDecl + ");")
                AddWithIndent(TAB, "}\n")
                let setRegIdNativeStr = if (isStaticProp) { "" } else { "long " + REGISTRY_ID_FIELD_NAME + ", " }
                AddWithIndent(TAB,
                    "private " + setterStatic + "final native void " + setSignature + "Impl(" + setRegIdNativeStr +
                        typeName + " " + varDecl + ");\n")
            }
        }
    }

    private func GenerateFuncParams(params: ArrayList<FuncParam>, isNativeMethod!: Bool = false): String {
        return GenerateParams(params, { cur: FuncParam =>
            MapCJTypeToJavaType(cur, imports, decl.fullPackageName, isNativeMethod: isNativeMethod) + " " +
                cur.identifier.Val()
        })
    }

    private func GenerateFuncParamLists(paramLists: ArrayList<FuncParamList>, isNativeMethod!: Bool = false): String {
        return GenerateParamLists(paramLists, { cur: FuncParam =>
            CJC_ASSERT(cur.typeNode.isSome() && cur.GetTy().isSome())
            MapCJTypeToJavaType(cur, imports, decl.fullPackageName, isNativeMethod: isNativeMethod) + " " +
                cur.identifier.Val()
        })
    }

    private func GenerateFuncParamClasses(paramLists: ArrayList<FuncParamList>): String {
        if (!paramLists.isEmpty()) {
            return Join<FuncParam>(paramLists[0].params, ",", { cur: FuncParam =>
                CJC_ASSERT(cur.typeNode.isSome() && cur.GetTy().isSome())
                MapCJTypeToJavaType(cur, imports, decl.fullPackageName, isNativeMethod: false) + ".class"
            })
        }
        return ""
    }

    private func GenerateConstructorDecl(funcDecl: FuncDecl, isForCangjie: Bool): String {
        var declaration = ""
        if (!isForCangjie && funcDecl.TestAttr(Attribute.PUBLIC)) {
            declaration += JAVA_PUBLIC
            declaration += JAVA_WHITESPACE
        } else if (!isForCangjie && funcDecl.TestAttr(Attribute.PROTECTED)) {
            declaration += JAVA_PROTECTED
            declaration += JAVA_WHITESPACE
        } else if (isForCangjie) {
            declaration += JAVA_PRIVATE
            declaration += JAVA_WHITESPACE
        }
        declaration = declaration + decl.identifier.Val() + "("
        var params = ""
        if (let Some(body) <- funcDecl.funcBody) {
            params += GenerateFuncParamLists(body.paramLists)
            if (isForCangjie) {
                if (!params.isEmpty()) {
                    params += JAVA_COMMA
                    params += JAVA_WHITESPACE
                }
                params += JavaClassSignature.GetConstructorMarkerClass().GetUnqualifiedTypeName()
                params += JAVA_WHITESPACE
                params += JAVA_SPECIAL_PARAM_NAME
            }
        }
        declaration += params
        declaration += ")"
        return declaration
    }

    private func GenerateParams(params: ArrayList<FuncParam>, transform: (FuncParam) -> String): String {
        return Join<FuncParam>(params, ", ", transform)
    }

    private func GenerateParamLists(paramLists: ArrayList<FuncParamList>, transform: (FuncParam) -> String): String {
        if (!paramLists.isEmpty()) {
            return GenerateParams(paramLists[0].params, transform)
        }
        return ""
    }

    private func GenNativeSuperArgCall(arg: FuncArg, nativeFunc: FuncDecl,
        params: ArrayList<FuncParam>): (String, String) {
        var id = nativeFunc.identifier.Val()
        let keyword = "_super"
        let found = id.lastIndexOf(keyword)
        CJC_ASSERT(found.isSome())
        id = id[found.getOrThrow() + 1..]
        let parts = SplitString(id[keyword.size..], "P")
        let args = ArrayList<String>()
        let nativeParams = ArrayList<String>()
        var index: Int64 = 1
        while (index < parts.size) {
            let pid = Stoi(parts[index])
            CJC_ASSERT(pid.isSome())
            let paramIndex = pid.getOrThrow()
            let pname = params[paramIndex].identifier.Val()
            args.add(pname)
            nativeParams.add(MapCJTypeToJavaType(params[paramIndex].GetTy().getOrThrow(), imports,
                decl.fullPackageName) + " " + pname)
            index++
        }
        let superCall = id + "(" + Join<String>(args, ", ", { part: String => part }) + ")"
        let nativeFnDecl = "private static final native " +
            MapCJTypeToJavaType(arg.GetTy().getOrThrow(), imports, decl.fullPackageName) + " " + id + "(" +
            Join<String>(nativeParams, ", ", { part: String => part }) + ");"
        return (superCall, nativeFnDecl)
    }

    private func GenerateSuperCall(call: CallExpr, nativeFuncs: ArrayList<Option<FuncDecl>>,
        params: ArrayList<FuncParam>, nativeFunctions: ArrayList<String>): String {
        let args = ArrayList<String>()
        var index: Int64 = 0
        while (index < nativeFuncs.size) {
            let nativeFunc = nativeFuncs[index]
            let originalArg = call.args[index]
            if (let Some(native) <- nativeFunc) {
                let (superCall, superNative) = GenNativeSuperArgCall(originalArg, native, params)
                args.add(superCall)
                nativeFunctions.add(superNative)
            } else {
                args.add(originalArg.expr.getOrThrow().ToString())
            }
            index++
        }
        return "super(" + Join<String>(args, ", ", { part: String => part }) + ");"
    }

    private func GenerateConstructorSuperCall(ctor: FuncDecl, nativeFunctions: ArrayList<String>): String {
        if (!ctx.HasDesugaredJavaImplSuperConstructorCall(ctor)) {
            return "super();"
        }
        let originalCall = ctx.GetJavaImplSuperCtorCall(ctor)
        let argNativeFuncs = ctx.GetJavaImplSuperCtorArgNativeFuncs(ctor)
        CJC_ASSERT(!ctor.funcBody.getOrThrow().paramLists.isEmpty())
        let params = ctor.funcBody.getOrThrow().paramLists[0].params
        return GenerateSuperCall(originalCall, argNativeFuncs, params, nativeFunctions)
    }

    private func AddConstructor(ctor: FuncDecl, superCall: String, isForCangjie: Bool): Unit {
        AddWithIndent(TAB, GenerateConstructorDecl(ctor, isForCangjie) + " {")
        if (!superCall.isEmpty()) {
            AddWithIndent(TAB2, superCall)
        }
        if (!isForCangjie) {
            let params = ctor.funcBody.getOrThrow().paramLists[0].params
            var initCall = GetMangledJniInitCjObjectFuncName(mangler, params, false) + "("
            if (ctor.funcBody.isSome()) {
                initCall += GenerateParamLists(ctor.funcBody.getOrThrow().paramLists, { param: FuncParam =>
                    FuncParamToString(param)
                })
            }
            initCall += ");"
            var assignRegistry = false
            if (let Some(outer) <- ctor.outerDecl) {
                assignRegistry = !IsImpl(outer)
            } else {
                assignRegistry = true
            }
            if (assignRegistry) {
                initCall = REGISTRY_ID_FIELD_NAME + " = " + initCall
            }
            AddWithIndent(TAB2, initCall)
        }
        AddWithIndent(TAB, "}\n")
    }

    private func AddConstructor(ctor: FuncDecl): Unit {
        let nativeFunctions = ArrayList<String>()
        let superCall = GenerateConstructorSuperCall(ctor, nativeFunctions)
        CJC_ASSERT_WITH_MSG(!ctor.funcBody.getOrThrow().paramLists.isEmpty(), "paramLists cannot be empty")
        let params = ctor.funcBody.getOrThrow().paramLists[0].params
        AddConstructor(ctor, superCall, false)
        AddConstructor(ctor, superCall, true)
        AddNativeInitCJObject(params, ctor)
        for (fn in nativeFunctions) {
            AddWithIndent(TAB, fn)
        }
    }

    private func AddConstructors(): Unit {
        for (member in decl.GetMemberDecls()) {
            if (let Some(fd) <- (member as FuncDecl)) {
                if (!fd.TestAttr(Attribute.CONSTRUCTOR)) {
                    continue
                }
                if (!IsMemberExportable(fd)) {
                    continue
                }
                if (IsGeneratedJavaImplConstructor(fd)) {
                    continue
                }
                AddConstructor(fd)
            }
        }
    }

    private func AddInstanceMethod(funcDecl: FuncDecl): Unit {
        CJC_ASSERT_WITH_MSG(!funcDecl.funcBody.getOrThrow().paramLists.isEmpty(), "paramLists cannot be empty")
        let params = funcDecl.funcBody.getOrThrow().paramLists[0].params
        let funcIdentifier = GetJavaMemberName(funcDecl)
        let mangledNativeName = GetMangledMethodName(mangler, params, funcIdentifier)
        let modifier = GetExportedMemberModifier(funcDecl)
        if (funcDecl.TestAttr(Attribute.OVERRIDE)) {
            AddWithIndent(TAB, "@Override")
        }
        let retType = MapCJTypeToJavaType(funcDecl.funcBody.getOrThrow().retType.getOrThrow(), imports,
            decl.fullPackageName)
        var methodSignature = modifier + "final " + retType + " "
        methodSignature += funcIdentifier + "("
        var argsWithTypes = GenerateFuncParamLists(funcDecl.funcBody.getOrThrow().paramLists, isNativeMethod: false)
        methodSignature += argsWithTypes
        methodSignature += ") {"
        AddWithIndent(TAB, methodSignature)
        var args = "this." + REGISTRY_ID_FIELD_NAME
        let paramList = Join<FuncParam>(params, ", ", { param: FuncParam => FuncParamToString(param) })
        if (!paramList.isEmpty()) {
            args += ", "
            args += paramList
        }
        var funcCall = mangledNativeName + "(" + args + ");"
        if (retType != "void") {
            funcCall = "return " + funcCall
        }
        AddWithIndent(TAB2, funcCall)
        AddWithIndent(TAB, "}\n")
        argsWithTypes = GenerateFuncParamLists(funcDecl.funcBody.getOrThrow().paramLists, isNativeMethod: true)
        let comma = if (argsWithTypes.isEmpty()) { "" } else { ", " }
        AddWithIndent(TAB,
            "private final native " + retType + " " + mangledNativeName + "(long " + REGISTRY_ID_FIELD_NAME + comma +
                argsWithTypes + ");\n")
    }

    private func AddStaticMethod(funcDecl: FuncDecl): Unit {
        CJC_ASSERT_WITH_MSG(!funcDecl.funcBody.getOrThrow().paramLists.isEmpty(), "paramLists cannot be empty")
        let params = funcDecl.funcBody.getOrThrow().paramLists[0].params
        let funcIdentifier = GetJavaMemberName(funcDecl)
        let mangledNativeName = GetMangledMethodName(mangler, params, funcIdentifier)
        let modifier = GetExportedMemberModifier(funcDecl)
        let retType = MapCJTypeToJavaType(funcDecl.funcBody.getOrThrow().retType.getOrThrow(), imports,
            decl.fullPackageName)
        var argsWithTypes = GenerateFuncParamLists(funcDecl.funcBody.getOrThrow().paramLists, isNativeMethod: false)
        let paramList = Join<FuncParam>(params, ", ", { param: FuncParam => FuncParamToString(param) })
        if (mangledNativeName != funcIdentifier) {
            AddWithIndent(TAB, modifier + "static final " + retType + " " + funcIdentifier + "(" + argsWithTypes + ") {")
            var funcCall = mangledNativeName + "(" + paramList + ");"
            if (retType != "void") {
                funcCall = "return " + funcCall
            }
            AddWithIndent(TAB2, funcCall)
            AddWithIndent(TAB, "}\n")
        }
        argsWithTypes = GenerateFuncParamLists(funcDecl.funcBody.getOrThrow().paramLists, isNativeMethod: true)
        var methodSignature = if (mangledNativeName == funcIdentifier) { modifier } else { "private " }
        methodSignature += "static final native " + retType + " "
        methodSignature += mangledNativeName + "("
        methodSignature += argsWithTypes
        methodSignature += ");\n"
        AddWithIndent(TAB, methodSignature)
    }

    private func AddMethods(): Unit {
        let funcDecls = ArrayList<Decl>()
        for (extendDecl in extendDecls) {
            for (member in extendDecl.GetMemberDecls()) {
                if (member.TestAttr(Attribute.PUBLIC) && IsFuncDeclAndNotConstructor(member)) {
                    funcDecls.add(member)
                }
            }
        }
        for (member in decl.GetMemberDecls()) {
            if (IsMemberExportable(member) && IsFuncDeclAndNotConstructor(member)) {
                funcDecls.add(member)
            }
        }
        for (fdecl in funcDecls) {
            let funcDecl = (fdecl as FuncDecl).getOrThrow()
            if (let Some(body) <- funcDecl.funcBody) {
                if (body.retType.isSome()) {
                    if (funcDecl.TestAttr(Attribute.STATIC)) {
                        AddStaticMethod(funcDecl)
                    } else {
                        AddInstanceMethod(funcDecl)
                    }
                }
            }
        }
    }

    private func AddEndClassParenthesis(): Unit {
        res += "}\n"
    }

    private func AddNativeInitCJObject(params: ArrayList<FuncParam>, ctor: FuncDecl): Unit {
        let _ = ctor
        let name = GetMangledJniInitCjObjectFuncName(mangler, params, false)
        let strParams = GenerateFuncParams(params, isNativeMethod: true)
        var signature = "private final native "
        signature += "void "
        signature += name + "(" + strParams + ");\n"
        AddWithIndent(TAB, signature)
    }

    private func AddNativeDeleteCJObject(): Unit {
        AddWithIndent(TAB, "private final native void deleteCJObject(long " + REGISTRY_ID_FIELD_NAME + ");\n")
    }

    private func AddFinalize(): Unit {
        AddWithIndent(TAB, "@Override")
        AddWithIndent(TAB, "protected void finalize() {")
        AddWithIndent(TAB2, "deleteCJObject(this." + REGISTRY_ID_FIELD_NAME + ");")
        AddWithIndent(TAB, "}")
    }
}
