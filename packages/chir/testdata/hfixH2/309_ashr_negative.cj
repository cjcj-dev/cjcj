package hfixh2_309

public func shiftMinusThree(value: Int64): Int64 {
    if (value == -3) {
        return value >> 1
    }
    return 0
}

public func shiftMinusFive(value: Int64): Int64 {
    if (value == -5) {
        return value >> 1
    }
    return 0
}

public func shiftMinusSeven(value: Int64): Int64 {
    if (value == -7) {
        return value >> 2
    }
    return 0
}
