diff --git a/cmake/mingw_x86_64_toolchain.cmake b/cmake/mingw_x86_64_toolchain.cmake
index 460252e1..4b7d2ac0 100644
--- a/cmake/mingw_x86_64_toolchain.cmake
+++ b/cmake/mingw_x86_64_toolchain.cmake
@@ -78,12 +78,18 @@ endif()
 # Besides gcc and g++, there are also copies of them with the triple prefix
 # in a native MinGW toolchain, like x86_64-w64-mingw32-gcc.
 # Use those with the prefix here in order to be compatible with cross-compilation.
-set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc)
-set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)
+# Preserve an explicitly selected compiler (including its absolute path).
+# The historical names are llvm-mingw aliases, not a requirement to use GCC.
+if(NOT CMAKE_C_COMPILER)
+    set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc)
+endif()
+if(NOT CMAKE_CXX_COMPILER)
+    set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)
+endif()
 find_program(CMAKE_AR llvm-ar)
 find_program(CMAKE_RANLIB llvm-ranlib)
-set(LLVM_BUILD_C_COMPILER x86_64-w64-mingw32-gcc)
-set(LLVM_BUILD_CXX_COMPILER x86_64-w64-mingw32-g++)
+set(LLVM_BUILD_C_COMPILER "${CMAKE_C_COMPILER}")
+set(LLVM_BUILD_CXX_COMPILER "${CMAKE_CXX_COMPILER}")
 
 set(LINKER_OPTION_PREFIX "-Wl,")
 set(MAKE_SO_STACK_PROTECTOR_OPTION -fstack-protector)
diff --git a/cmake/modules/InstallWindowsToolchain.cmake b/cmake/modules/InstallWindowsToolchain.cmake
new file mode 100644
index 00000000..12ace0c4
--- /dev/null
+++ b/cmake/modules/InstallWindowsToolchain.cmake
@@ -0,0 +1,13 @@
+# Native producer supplies the DLLs from its selected MSVCRT toolchain.
+# Use normal CMake installation so the manifest and the transported install
+# include the runtime needed by cjc, LLVM/CJDB and the installed host flatc.
+if(WIN32 AND CANGJIE_TOOLCHAIN_RUNTIME_FILES)
+    foreach(runtime_file IN LISTS CANGJIE_TOOLCHAIN_RUNTIME_FILES)
+        if(NOT EXISTS "${runtime_file}")
+            message(FATAL_ERROR "Selected Windows toolchain runtime is missing: ${runtime_file}")
+        endif()
+    endforeach()
+    foreach(destination bin third_party/llvm/bin third_party/flatbuffers/bin)
+        install(FILES ${CANGJIE_TOOLCHAIN_RUNTIME_FILES} DESTINATION "${destination}")
+    endforeach()
+endif()
